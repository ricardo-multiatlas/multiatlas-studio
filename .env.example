# ============================================================================
# Multiatlas Studio — variables de entorno de Stripe (CASCARÓN)
# Copia este archivo a ".env" (o pégalas en Vercel → Settings → Environment Variables)
# y rellena los valores. NUNCA subas .env ni la secret key al repo.
#
# Solo se necesitan si usas Checkout Session (checkout/stripe.js → mode:"session").
# Con Payment Links (mode:"links") NO hace falta ninguna de estas.
# ============================================================================

# Secret key de tu cuenta Stripe (Developers → API keys). Empieza con sk_live_ o sk_test_
STRIPE_SECRET_KEY=

# Precio recurrente del plan Pro ($19/mes). Product → Add price (recurring) → copia el price_...
PRICE_PRO=

# Precio único del plan Founding ($249, de por vida). Product → Add price (one-time) → price_...
PRICE_FOUNDING=

# Firma del webhook (Developers → Webhooks → tu endpoint → Signing secret). Empieza con whsec_
# Solo si configuras /api/webhook para dar acceso automático.
STRIPE_WEBHOOK_SECRET=

# ── Clerk (login) — ver CLERK.md ──
# Secret key de Clerk (Dashboard → API Keys → Secret keys). Empieza con sk_. SOLO servidor.
CLERK_SECRET_KEY=
# La publishable key (pk_...) NO va aquí: va en checkout/auth.js (es pública, del lado del cliente).

# ── Base de datos (Neon Postgres) — guarda las suscripciones ──
# Neon → tu proyecto → Connection string. Empieza con postgresql://  SOLO servidor.
DATABASE_URL=

# ── IA (Nivel 2) — OpenRouter, para generar sites desde una descripción ──
# openrouter.ai → Keys. Empieza con sk-or-  SOLO servidor (nunca en el cliente).
OPENROUTER_API_KEY=
# Modelo a usar (opcional). Default: openai/gpt-4o-mini.
# Más calidad: anthropic/claude-3.5-sonnet · openai/gpt-4o · google/gemini-2.0-flash-001
OPENROUTER_MODEL=
